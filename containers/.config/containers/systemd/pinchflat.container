[Unit]
Description=Pinchflat

[Container]
ContainerName=pinchflat
Image=ghcr.io/thebadfella/pinchflat-ngx:latest
PublishPort=8945:8945
UserNS=keep-id
SecurityLabelDisable=true
Volume=%h/.config/pinchflat:/config:Z
Volume=/videos/tv/tv:/downloads:z
Environment=PUID=0
Environment=PGID=0
Environment=TZ=Asia/Kolkotta

[Service]
Restart=always

[Install]
WantedBy=default.target
