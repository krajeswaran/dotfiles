[Unit]
Description=Sonarr

[Container]
ContainerName=sonarr
Image=lscr.io/linuxserver/sonarr:latest
PublishPort=8989:8989
Volume=%h/.config/sonarr:/config:Z
Volume=/videos/tv:/tv:z
Environment=PUID=0
Environment=PGID=0
Environment=TZ=Asia/Kolkotta

[Service]
Restart=always

[Install]
WantedBy=default.target
