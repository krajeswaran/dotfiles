# Converted from compose service "database".

[Unit]
Description=database container

[Container]
Image=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23
ContainerName=database
Network=immich.network
Volume=%h/postgres:/var/lib/postgresql/data:U,Z
Secret=db_password,type=env,target=POSTGRES_PASSWORD
Environment=POSTGRES_USER=postgres
Environment=POSTGRES_DB=immich
Environment=POSTGRES_INITDB_ARGS=--data-checksums
Environment=DB_STORAGE_TYPE=SSD
Environment=PGDATA=/var/lib/postgresql/data/pgdata
UserNS=keep-id
User=1000
Group=1000
DropCapability=NET_RAW
NoNewPrivileges=true
ShmSize=128mb

[Service]
Restart=always

[Install]
WantedBy=default.target
